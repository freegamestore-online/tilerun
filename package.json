{
  "name": "tilerun",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "scripts": {
    "dev": "pnpm --filter @tilerun/web dev",
    "build": "pnpm --filter @tilerun/web build",
    "preview": "pnpm --filter @tilerun/web preview",
    "typecheck": "pnpm --filter @tilerun/web exec tsc -b",
    "lint": "pnpm --filter @tilerun/web lint",
    "test": "pnpm --filter @tilerun/web test"
  }
}
